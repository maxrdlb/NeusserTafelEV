# Neusser Tafel e.V. – Einstellungen für Apache-Webhosting
# (all-inkl, Hetzner, netcup, Uberspace u. a.; GitHub Pages ignoriert diese Datei)

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Immer HTTPS und immer ohne "www."
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://neussertafel.de%{REQUEST_URI} [L,R=301,NE]

  # Alte Jimdo-Adressen -> neue Seiten
  RewriteRule ^was-wir-leisten/?$                               /#angebote     [L,R=301,NE]
  RewriteRule ^wie-sie-helfen-ausfuehrlich/spendenformular/?$   /spendenformular.html [L,R=301]
  RewriteRule ^wie-sie-helfen-ausfuehrlich/?$                   /#helfen       [L,R=301,NE]
  RewriteRule ^wie-sie-helfen/?$                                /#helfen       [L,R=301,NE]
  RewriteRule ^so-erreichen-sie-uns/?$                          /#standorte    [L,R=301,NE]
  RewriteRule ^wer-wir-sind-ausfuehrlich/?$                     /#ueber-uns    [L,R=301,NE]
  RewriteRule ^wer-wir-sind/?$                                  /#ueber-uns    [L,R=301,NE]
  RewriteRule ^about/?$                                         /impressum.html  [L,R=301]
  RewriteRule ^j/privacy/?$                                     /datenschutz.html [L,R=301]
  RewriteRule ^app/download/.*Patenschafts-Antrag\.pdf$         /assets/docs/Patenschafts-Antrag.pdf [L,R=301]
</IfModule>

<IfModule mod_headers.c>
  # Browser nur noch per HTTPS (erst aktivieren, wenn HTTPS sicher läuft)
  Header always set Strict-Transport-Security "max-age=31536000"
  # Nur eigene Skripte; Kartenkacheln nur von OpenStreetMap
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://tile.openstreetmap.org; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/png "access plus 1 month"
</IfModule>
